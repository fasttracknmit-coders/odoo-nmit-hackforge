<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Attendance List View -->
    <record id="view_dayflow_attendance_list" model="ir.ui.view">
        <field name="name">dayflow.attendance.list</field>
        <field name="model">dayflow.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="status"/>
                <field name="worked_hours"/>
                <field name="late_minutes"/>
            </list>
        </field>
    </record>

    <!-- Attendance Form View -->
    <record id="view_dayflow_attendance_form" model="ir.ui.view">
        <field name="name">dayflow.attendance.form</field>
        <field name="model">dayflow.attendance</field>
        <field name="arch" type="xml">
            <form string="Attendance">
                <sheet>

                    <group>
                        <field name="employee_id"/>
                        <field name="date"/>
                        <field name="status"/>
                    </group>

                    <group>
                        <field name="check_in"/>
                        <field name="check_out"/>
                        <field name="worked_hours"/>
                        <field name="late_minutes"/>
                    </group>

                    <group>
                        <field name="remarks"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Attendance Action -->
    <record id="action_dayflow_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">dayflow.attendance</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Attendance Menu -->
    <menuitem
        id="menu_dayflow_attendance"
        name="Attendance"
        action="action_dayflow_attendance"
        sequence="20"/>
        
</odoo>