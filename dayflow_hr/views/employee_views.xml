<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dayflow_employee_list" model="ir.ui.view">
        <field name="name">dayflow.employee.list</field>
        <field name="model">dayflow.employee</field>
        <field name="arch" type="xml">
            <list string="Employees">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="job_title"/>
                <field name="department"/>
                <field name="email"/>
                <field name="role"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_dayflow_employee_form" model="ir.ui.view">
        <field name="name">dayflow.employee.form</field>
        <field name="model">dayflow.employee</field>
        <field name="arch" type="xml">
            <form string="Employee">
                <sheet>
                    <group>
                        <group>
                            <field name="profile_picture" widget="image"/>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="user_id"/>
                        </group>

                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="address"/>
                        </group>
                    </group>

                    <group string="Job Details">
                        <field name="job_title"/>
                        <field name="department"/>
                        <field name="joining_date"/>
                        <field name="role"/>
                    </group>

                    <group string="Salary">
                        <field name="salary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dayflow_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">dayflow.employee</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_dayflow_root"
        name="Dayflow"
        sequence="10"
    />

    <menuitem
        id="menu_dayflow_employee"
        name="Employees"
        parent="menu_dayflow_root"
        action="action_dayflow_employee"
        sequence="10"
    />

</odoo>